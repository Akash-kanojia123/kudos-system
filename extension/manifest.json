{
  "manifest_version": 3,
  "name": "Kudos Extractor",
  "version": "3.0.0",
  "description": "Extract kudos from client emails",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:4000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kudos Extractor"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["extract-form.html", "extract-form.js", "extract-form.css"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}